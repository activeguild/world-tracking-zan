{
  "name": "world-tracking-zan",
  "private": true,
  "version": "0.1.0",
  "description": "Self-built WebAR plane detection and visual tracking engine (Phase 1: feature tracking)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "check": "npm run typecheck && npm run test",
    "mutate": "mutator",
    "mutate:diff": "mutator --since origin/main --include-test-changes",
    "mutate:ci": "mutator --fail-on-survived",
    "lean:check": "bash scripts/lean-check.sh",
    "lean:export": "cd lean && lake build conformance && lake exe conformance > conformance/tracking-state.json"
  },
  "devDependencies": {
    "@mizchi/mutator": "0.5.5",
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "playwright": "^1.57.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
